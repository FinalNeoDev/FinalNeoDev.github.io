---
import { Image } from 'astro:assets'
import profileFalcon from '@assets/profile_falcon.png'

const currentYear = new Date().getFullYear()
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-900/50 mt-auto transition-colors">
  <div class="container py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-purple-500 shadow-sm shrink-0">
          <Image src={profileFalcon} alt="FinalNeo" class="object-cover w-full h-full" />
        </div>
        <div>
          <span class="font-bold text-lg text-gray-900 dark:text-gray-100">FinalNeo</span>
          <p class="text-xs text-gray-500 dark:text-gray-400">Personal Dev & Service Showcase</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-gray-600 dark:text-gray-400">
        <a href="/" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Home</a>
        <a href="/#portfolio" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Portfolio</a>
        <a href="https://github.com/FinalNeoDev" target="_blank" rel="noopener noreferrer" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">GitHub</a>
        <a href="https://finalneodev.github.io/privacy-policy/" target="_blank" rel="noopener noreferrer" class="hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Privacy Policy</a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-200/60 dark:border-gray-800/60 text-center text-xs text-gray-400">
      <p>&copy; {currentYear} FinalNeo. All rights reserved.</p>
    </div>
  </div>
</footer>
