---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import profileFalcon from '../assets/profile_falcon.png'
import { Image } from 'astro:assets'

const projects = [
  {
    title: 'Korea Holidays',
    subtitle: '대한민국 공휴일 & 기념일 안내',
    description: '대한민국의 법정 공휴일, 대체 공휴일 및 주요 기념일 정보를 한눈에 확인하고 편리하게 조회할 수 있는 웹 캘린더 서비스입니다.',
    url: 'https://finalneodev.github.io/Korea_Holidays/',
    tags: ['Web Service', 'Calendar', 'Holidays'],
    badge: 'Live',
    badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    icon: '📅'
  },
  {
    title: 'Korea OT',
    subtitle: '초과 근무 및 수당 계산기',
    description: '연장·야간·휴일 근무 시간과 통상 시급을 기반으로 복잡한 초과 수당을 빠르고 정확하게 산출해주는 실용적인 계산 도구입니다.',
    url: 'https://finalneodev.github.io/Korea_Holidays/overtime.html',
    tags: ['Calculator', 'Utility', 'Productivity'],
    badge: 'Utility',
    badgeColor: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20',
    icon: '⏱️'
  },
  {
    title: 'Korea Font',
    subtitle: 'KERIS 안심 글꼴 뷰어',
    description: '한국교육학술정보원(KERIS)의 오픈 폰트 라이선스(OFL) 안심 글꼴 정보를 제공하고 실시간 타이핑 미리보기를 지원합니다.',
    url: 'https://finalneodev.github.io/KERIS_OFL_fonts/',
    tags: ['Typography', 'Font Viewer', 'OFL'],
    badge: 'Open Source',
    badgeColor: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
    icon: '🔤'
  }
]
---

<DefaultLayout title="FinalNeoDev - Portfolio & Projects" hideFooter={false}>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden">
    <div class="container relative z-10">
      <div class="flex flex-col md:flex-row items-center justify-center gap-10 md:gap-16 max-w-5xl mx-auto">
        <!-- Left: Profile Falcon Image with Glow -->
        <div class="relative group shrink-0">
          <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-purple-600 to-teal-400 opacity-60 blur-lg group-hover:opacity-100 transition duration-500 group-hover:scale-105"></div>
          <div class="relative w-48 h-48 md:w-60 md:h-60 rounded-full overflow-hidden border-4 border-white dark:border-gray-900 shadow-2xl transition duration-300 group-hover:scale-[1.02]">
            <Image
              src={profileFalcon}
              alt="FinalNeoDev Profile Falcon"
              class="object-cover w-full h-full"
              priority
            />
          </div>
        </div>

        <!-- Right: Title, Subtitle & Action Buttons -->
        <div class="flex flex-col items-center md:items-start text-center md:text-left">
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">
            <span class="text-gradient">FinalNeoDev</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 font-medium max-w-xl mb-3">
            아이디어와 기술을 잇는 웹 서비스를 연구하고 개발합니다.
          </p>
          <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 max-w-md mb-8">
            실생활에 도움이 되는 편리하고 직관적인 웹 도구를 만듭니다.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
            <a
              href="#portfolio"
              class="px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-semibold shadow-lg shadow-purple-600/25 hover:shadow-purple-600/40 transition-all duration-200 inline-flex items-center gap-2 transform hover:-translate-y-0.5"
            >
              <span>포트폴리오 보기</span>
              <span class="text-lg">↓</span>
            </a>
            <a
              href="https://github.com/FinalNeoDev"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl border border-gray-300 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-600 bg-white/70 dark:bg-gray-800/70 text-gray-800 dark:text-gray-200 font-semibold backdrop-blur-sm shadow-sm hover:shadow transition-all duration-200 inline-flex items-center gap-2 transform hover:-translate-y-0.5"
            >
              <span>GitHub 방문</span>
              <span class="text-base">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio" class="py-20 bg-gray-50/70 dark:bg-gray-950/40 border-t border-gray-200/80 dark:border-gray-800/80 transition-colors scroll-mt-12">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
          Featured <span class="text-gradient">Portfolio</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-sm md:text-base">
          현재 서비스 중인 주요 웹 프로젝트들을 확인해보세요.
        </p>
      </div>

      <!-- Project Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {projects.map((project) => (
          <div class="group relative flex flex-col justify-between p-7 bg-white dark:bg-gray-900 border border-gray-200/90 dark:border-gray-800/90 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/50 dark:hover:border-purple-500/50">
            <div>
              <!-- Card Header -->
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="text-3xl p-2.5 rounded-xl bg-gray-100 dark:bg-gray-800/80 border border-gray-200/50 dark:border-gray-700/50 shadow-inner">
                  {project.icon}
                </div>
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${project.badgeColor}`}>
                  {project.badge}
                </span>
              </div>

              <!-- Project Title & Subtitle -->
              <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                {project.title}
              </h3>
              <p class="text-xs font-medium text-purple-600/90 dark:text-purple-400/90 mb-3">
                {project.subtitle}
              </p>

              <!-- Description -->
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
                {project.description}
              </p>
            </div>

            <div>
              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {project.tags.map((tag) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 border border-gray-200/60 dark:border-gray-700/60">
                    #{tag}
                  </span>
                ))}
              </div>

              <!-- Action Link -->
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-2.5 px-4 rounded-xl font-medium text-sm text-center inline-flex items-center justify-center gap-1.5 bg-purple-50 dark:bg-purple-950/30 text-purple-700 dark:text-purple-300 hover:bg-purple-600 hover:text-white dark:hover:bg-purple-600 dark:hover:text-white border border-purple-200 dark:border-purple-800/60 transition-all duration-200"
              >
                <span>서비스 바로가기</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  :root {
    --accent-gradient: linear-gradient(
      135deg,
      #9333ea 0%,
      #c084fc 40%,
      #14b8a6 100%
    );
  }

  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200%;
    background-position: 0%;
  }

  html {
    scroll-behavior: smooth;
  }
</style>
