---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading } from 'accessible-astro-components'

const pages = [
  {
    title: 'Home',
    url: '/',
    description: 'FinalNeoDev 메인 페이지 및 소개',
  },
  {
    title: 'Portfolio (Featured Projects)',
    url: '/#portfolio',
    description: 'Korea Holidays, Korea OT, Korea Font 등 주요 웹 프로젝트 쇼케이스',
  },
  {
    title: 'Privacy Policy',
    url: 'https://finalneodev.github.io/privacy-policy/',
    description: '개인정보 처리방침 안내',
  },
]
---

<DefaultLayout
  title="Sitemap - FinalNeoDev"
  description="FinalNeoDev 사이트맵"
>
  <section class="py-20">
    <div class="container max-w-4xl">
      <Heading level="h1" class="text-3xl font-bold mb-8">Sitemap</Heading>
      <div class="grid gap-6 md:grid-cols-2">
        {
          pages.map((page) => (
            <article class="p-6 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl">
              <Heading level="h2" size="h5" class="mb-2 font-bold">
                <a href={page.url} class="text-purple-600 dark:text-purple-400 hover:underline">{page.title}</a>
              </Heading>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">{page.description}</p>
              <p class="text-xs text-gray-400">
                URL: <code class="bg-gray-100 dark:bg-gray-800 px-1 py-0.5 rounded">{page.url}</code>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</DefaultLayout>
